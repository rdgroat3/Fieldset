# Dependencies — never commit these. EAS installs them in the cloud.
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build output (generated by prebuild)
/ios
/android

# Metro
.metro-health-check*

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Local env / secrets — keep the AI decode token out of git
.env
.env.local
*.pem

# EAS
.easignore
